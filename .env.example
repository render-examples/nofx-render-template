# Reference only — Render sets these via render.yaml and the dashboard.
# Do not commit real secrets.

JWT_SECRET=
DATA_ENCRYPTION_KEY=
# RSA_PRIVATE_KEY is auto-generated on first boot by railway/start.sh if unset.

DB_TYPE=sqlite
DB_PATH=/app/data/data.db
TZ=UTC
TRANSPORT_ENCRYPTION=false
AI_MAX_TOKENS=8000

# After deploy, configure in the NOFX UI (not env vars):
